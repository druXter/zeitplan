DATABASE_URL="file:./dev.db"

# Basis-URL für generierte Links (Einladung, Passwort-Reset, Gästelink, QR-Code und
# Tafel-Link). In Produktion die echte, öffentlich erreichbare Domain eintragen (ohne
# abschließenden Slash). Sie ist zugleich die Kennung dieses Tools gegenüber anderen Tools der
# Suite (SUITE_*, unten) - muss also exakt der Adresse entsprechen, unter der die anderen Tools es erreichen.
BASE_URL=http://localhost:3800

# Wie viele Reverse Proxys vor diesem Tool stehen. Bestimmt, welcher Eintrag von
# X-Forwarded-For als Besucher-IP für die Drosselung gilt (von rechts gezählt - links steht
# Beliebiges, das der Client selbst mitschicken kann). 1 = ein Proxy. 0 = direkter Zugriff
# ohne Proxy (der Header wird dann komplett ignoriert und alle Besucher teilen sich EINEN
# Zähler - nur für lokale Entwicklung sinnvoll).
# Nicht raten, sondern messen: Hinter dem Cloudflare Tunnel (cloudflared, ohne weiteren Proxy)
# stand bei Seating die echte Besucher-IP als LETZTER Eintrag, also 1 - für dieses Tool erneut prüfen:
# einen Fehlversuch beim Login machen und schauen, ob in LoginThrottle eine Zeile
# mit dem Schlüssel SHA-256("login:ip" + Null-Byte + <eigene IP>) existiert.
TRUST_PROXY_HOPS=1

# Impressum-Angaben (siehe app/impressum/page.tsx) - gleiche Namen wie in den anderen
# Tools der Suite. Ohne diese Werte zeigt die Seite Platzhalter.
IMPRESSUM_NAME=
IMPRESSUM_STREET=
IMPRESSUM_ZIP=
IMPRESSUM_CITY=
IMPRESSUM_EMAIL=
IMPRESSUM_PHONE=

# Für den Aufräum-Cronjob (app/api/cron/cleanup), von einem externen Scheduler (z.B.
# Uptime Kuma) täglich mit ?secret=... aufgerufen. Leer = Endpunkt lehnt alles ab.
# Generieren z.B. mit: openssl rand -hex 24
CRON_SECRET=

# Zugang für Gäste bei geschützten Events (docs/KONZEPT.md Abschnitt 6). Je mindestens 32 Zeichen,
# eigene Werte (nie aus einem anderen Tool übernehmen). Generieren z.B. mit: openssl rand -base64 36
# ACCESS_CODE_SECRET: Schlüssel, mit dem Zugangscodes als HMAC gespeichert werden. Leer = kein Zugang
# per Code möglich. Ändert er sich, gelten alle festgelegten Codes nicht mehr (neu festlegen).
ACCESS_CODE_SECRET=
# DISPLAY_LINK_SECRET: Schlüssel, aus dem der Tafel-Link geschützter Events abgeleitet wird. Leer = die
# Tafel zeigt geschützte Events nicht. Zum Wechseln den alten Wert vorübergehend in
# DISPLAY_LINK_SECRET_PREVIOUS eintragen, dann funktionieren verteilte Tafel-Links weiter.
DISPLAY_LINK_SECRET=
DISPLAY_LINK_SECRET_PREVIOUS=

# --- Konto-Föderation der App-Suite (optional, siehe README "Anmelden mit einem Konto aus einem
# anderen Tool" und README von suite-kit). Ohne diese Werte arbeitet Zeitplan nur mit eigenen
# Konten - es gibt dann nicht einmal einen Login-Button für andere Tools.

# Anzeigename dieses Tools auf den Login-Buttons anderer Tools (Standard: Zeitplan).
SUITE_APP_NAME="Zeitplan"

# ANBIETER-Seite: Privater Signierschlüssel dieses Tools. Erzeugen mit:
#   node node_modules/suite-kit/bin/suite-keygen.js
# Geheim halten - er verlässt dieses Tool nie, jedes Tool hat seinen eigenen. Der öffentliche
# Teil wird automatisch unter /.well-known/suite-identity veröffentlicht. Leer = Zeitplan stellt
# keine Logins für andere Tools aus.
SUITE_SIGNING_KEY=
# Nur während einer Schlüsselrotation: der bisherige Schlüssel, damit noch gültige
# Bestätigungen weiter prüfbar bleiben (2 Minuten reichen).
SUITE_SIGNING_KEY_PREVIOUS=

# ANBIETER-Seite: Kommagetrennte Origins der Tools, die Logins von hier empfangen dürfen,
# z.B. https://rsvp.deine-domain.de,https://vote.deine-domain.de
SUITE_TRUSTED_APPS=

# EMPFÄNGER-Seite: Tools, mit deren Konten man sich hier anmelden darf. Entweder Origins
# kommagetrennt (https://rsvp.deine-domain.de) oder JSON für Einzeleinstellungen:
#   [{"issuer":"https://rsvp.deine-domain.de","label":"rsvp-app","autoProvision":false}]
# autoProvision: erster Login legt automatisch ein Konto ohne Passwort an (Standard: true).
#                Für Zeitplan empfohlen: false - Konten brauchen hier nur Planende und
#                Moderator*innen; wer eingeladen ist, verknüpft das andere Konto unter
#                "Mein Konto". true lässt jedes Konto des anderen Tools herein (z.B. für
#                Events mit Zugang "nur mit Konto") - als Creator, der eigene Events anlegen darf.
# mapAdminRole:  Admins des anderen Tools werden hier ebenfalls Admin (Standard: false,
#                sonst Creator; Moderator*innen bleiben Moderator*innen).
SUITE_IDPS=

# SMTP-Zugangsdaten (siehe app/lib/mail.ts) - nur für Einladungs- und Passwort-Reset-Mails, Gäste
# bekommen keine Mails. Ohne SMTP_HOST wird der Einladungslink dem einladenden Konto auf dem
# Bildschirm angezeigt, Passwort-Reset per Mail ist dann nicht möglich.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Zeitplan <deine-email@domain.de>"
