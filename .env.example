DATABASE_URL="file:./dev.db"

# Basis-URL für generierte Links (Einladung, Passwort-Reset, später Gästelink, QR-Code und
# Tafel-Link). In Produktion die echte, öffentlich erreichbare Domain eintragen (ohne
# abschließenden Slash). Ab Phase 6 ist sie zugleich die Kennung dieses Tools gegenüber anderen
# Tools der Suite - muss also exakt der Adresse entsprechen, unter der die anderen Tools es erreichen.
BASE_URL=http://localhost:3800

# Wie viele Reverse Proxys vor diesem Tool stehen. Bestimmt, welcher Eintrag von
# X-Forwarded-For als Besucher-IP für die Drosselung gilt (von rechts gezählt - links steht
# Beliebiges, das der Client selbst mitschicken kann). 1 = ein Proxy. 0 = direkter Zugriff
# ohne Proxy (der Header wird dann komplett ignoriert und alle Besucher teilen sich EINEN
# Zähler - nur für lokale Entwicklung sinnvoll).
# Nicht raten, sondern messen: Hinter dem Cloudflare Tunnel (cloudflared, ohne weiteren Proxy)
# stand bei Seating die echte Besucher-IP als LETZTER Eintrag, also 1 - für dieses Tool erneut prüfen:
# einen Fehlversuch beim Login machen und schauen, ob in LoginThrottle eine Zeile
# mit dem Schlüssel SHA-256("login:ip" + Null-Byte + <eigene IP>) existiert.
TRUST_PROXY_HOPS=1

# Impressum-Angaben (siehe app/impressum/page.tsx) - gleiche Namen wie in den anderen
# Tools der Suite. Ohne diese Werte zeigt die Seite Platzhalter.
IMPRESSUM_NAME=
IMPRESSUM_STREET=
IMPRESSUM_ZIP=
IMPRESSUM_CITY=
IMPRESSUM_EMAIL=
IMPRESSUM_PHONE=

# Für den Aufräum-Cronjob (app/api/cron/cleanup), von einem externen Scheduler (z.B.
# Uptime Kuma) täglich mit ?secret=... aufgerufen. Leer = Endpunkt lehnt alles ab.
# Generieren z.B. mit: openssl rand -hex 24
CRON_SECRET=

# Zugang für Gäste bei geschützten Events (docs/KONZEPT.md Abschnitt 6). Je mindestens 32 Zeichen,
# eigene Werte (nie aus einem anderen Tool übernehmen). Generieren z.B. mit: openssl rand -base64 36
# ACCESS_CODE_SECRET: Schlüssel, mit dem Zugangscodes als HMAC gespeichert werden. Leer = kein Zugang
# per Code möglich. Ändert er sich, gelten alle festgelegten Codes nicht mehr (neu festlegen).
ACCESS_CODE_SECRET=
# DISPLAY_LINK_SECRET: Schlüssel, aus dem der Tafel-Link geschützter Events abgeleitet wird. Leer = die
# Tafel zeigt geschützte Events nicht. Zum Wechseln den alten Wert vorübergehend in
# DISPLAY_LINK_SECRET_PREVIOUS eintragen, dann funktionieren verteilte Tafel-Links weiter.
DISPLAY_LINK_SECRET=
DISPLAY_LINK_SECRET_PREVIOUS=

# SMTP-Zugangsdaten (siehe app/lib/mail.ts) - nur für Einladungs- und Passwort-Reset-Mails, Gäste
# bekommen keine Mails. Ohne SMTP_HOST wird der Einladungslink dem einladenden Konto auf dem
# Bildschirm angezeigt, Passwort-Reset per Mail ist dann nicht möglich.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Zeitplan <deine-email@domain.de>"
