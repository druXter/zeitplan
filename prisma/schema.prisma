// prisma/schema.prisma
// Kein eigener migrations-Ordner - wie in den anderen Tools der Suite ausschließlich per
// `npx prisma db push` synchronisiert (siehe README.md/Dockerfile).
//
// Konten, Sitzungen, Einladungen, Drosselung (1:1 nach Seating), Events mit Freigaben und seit Phase 2 das
// vollständige Datenmodell aus docs/KONZEPT.md Abschnitt 9: Reihen, Spuren, Programmpunkte mit Live-Feldern,
// Abhängigkeiten, SECRET-Liste, Verlauf und Gast-Sitzungen. Felder, die erst spätere Phasen nutzen (Zugang,
// Tafel-Link, rsvp-Verknüpfung, Verlauf, Gast-Sitzungen), stehen schon hier, damit das Modell nicht mehr
// umgebaut werden muss.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// Gleiche Rollen wie in Seating und den anderen Tools der Suite, aber eigenständig vergeben:
// ADMIN sieht/verwaltet alle Events und Konten. CREATOR legt eigene Events an und gibt sie frei.
// MODERATOR legt nichts selbst an, sondern arbeitet nur in freigegebenen Events (z.B. der Trauzeuge
// bei der Hochzeit). Die Freigabe pro Event steht in EventAccess.
enum Role {
  ADMIN
  CREATOR
  MODERATOR
}

// Ein lokales Konto dieses Tools - für Planung und Moderation. Gäste haben kein Konto (sie bekommen
// höchstens eine Gast-Sitzung). Registrierung ist nicht öffentlich: Konten legt ein eingeloggtes Konto
// an (Einladungslink, siehe resetTokenHash) oder sie entstehen beim ersten Login über ein verbundenes
// Tool (Föderation, ExternalIdentity). passwordHash ist null bei noch nicht angenommenen Einladungen und
// bei rein föderierten Konten - beide können sich nicht per Passwort anmelden.
model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String?
  passwordHash String?
  role         Role     @default(CREATOR)
  createdAt    DateTime @default(now())
  // Zuletzt bei einer Anmeldung gesetzt (siehe issueSession in app/lib/auth.ts). Grundlage
  // für die automatische Löschung inaktiver Konten (app/api/cron/cleanup/route.ts) -
  // Admin-Konten sind davon ausgenommen.
  lastLoginAt  DateTime @default(now())

  // Einladung UND Passwort-Reset teilen sich denselben Mechanismus: ein einmaliger,
  // befristeter Link. Gespeichert wird nur der SHA-256-Hash des Tokens, damit ein
  // Datenbank-Leak keine gültigen Links preisgibt (siehe app/lib/auth.ts hashToken).
  resetTokenHash      String?   @unique
  resetTokenExpiresAt DateTime?

  sessions          Session[]
  events            Event[]
  eventAccess       EventAccess[]
  series            Series[]
  secretItems       ItemSecretViewer[]
  assignedItems     ItemAssignee[]
  liveActions       LiveAction[]       @relation("LiveActionActor")
  undoneActions     LiveAction[]       @relation("LiveActionUndoneBy")
  identities        ExternalIdentity[]
  pushSubscriptions PushSubscription[]
  alertSettings     AlertSetting[]
  alertsSent        AlertSent[]
}

// Server-seitige Session: das Cookie trägt nur den zufälligen Token, in der Datenbank
// liegt ausschließlich dessen SHA-256-Hash - ein Leak der Datenbank ergibt also keine
// übernehmbaren Sitzungen.
model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  pushSubscriptions      PushSubscription[]
  guestPushSubscriptions GuestPushSubscription[]

  @@index([userId])
}

// Web-Push-Abo eines Geräts für die Vorwarnung fürs Team (Idee L17, app/lib/push.ts), Aufbau wie im
// Abstimmungstool. Hängt an der SITZUNG, nicht nur am Konto: Wer sich auf einem Gerät abmeldet (oder dessen Sitzung
// abläuft), bekommt dort keine Mitteilungen mehr - wichtig auf geteilten Geräten. endpoint ist die Adresse beim
// Push-Dienst des Browsers (Google, Mozilla, Apple), p256dh/auth die Schlüssel, mit denen jede Nachricht
// Ende-zu-Ende verschlüsselt wird - der Push-Dienst sieht den Inhalt nicht.
model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessionId String
  session   Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  @@index([userId])
}

// Verknüpfung eines lokalen Kontos mit einem Konto in einem anderen Tool der Suite (Föderation über
// suite-kit, Phase 6, app/api/suite/*; Aufbau wie in Seating). Identität ist (issuer, subject) - NIE die
// E-Mail, die sich beim Anbieter ändern lässt. issuer = Origin des Anbieter-Tools, subject = dessen Konto-ID.
model ExternalIdentity {
  id        String   @id @default(cuid())
  issuer    String
  subject   String
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([issuer, subject])
  @@index([userId])
}

// Zähler gegen Passwort-Raten und Mail-Flut (siehe app/lib/throttle.ts). `key` ist ein
// SHA-256-Hash aus Bereich + Kennung (E-Mail bzw. IP-Adresse) - es werden also weder
// Adressen noch IPs im Klartext gespeichert. Zeilen werden nach Ablauf des Zeitfensters
// bei Gelegenheit wieder gelöscht.
model LoginThrottle {
  key         String   @id
  count       Int
  windowStart DateTime
}

// DRAFT: nur für Konten mit Zugriff. PUBLISHED: Gästeansicht mit Prognose. LIVE: Live-Steuerung aktiv,
// Ursprungsplan beim Live-Schalten eingefroren. ENDED: nach Eventende (auch automatisch, app/lib/live/store.ts
// endIfOver), Rückblick ohne Live-Steuerung. ARCHIVED: nicht mehr öffentlich (docs/KONZEPT.md Abschnitt 4).
enum EventStatus {
  DRAFT
  PUBLISHED
  LIVE
  ENDED
  ARCHIVED
}

// Zugang der Gäste zu /<slug> (docs/KONZEPT.md Abschnitt 6, app/lib/guest/access.ts). RSVP kommt mit Phase 7b.
enum GuestAccess {
  PUBLIC
  CODE
  ACCOUNT
  RSVP
}

// Ein Ablauf unter /<slug> (Gästeansicht ab Phase 3). date: Beginn des Eventtags in der Zeitzone des
// Events als UTC-Zeitpunkt (00:00 Ortszeit) - der Tag, an dem der Ablauf beginnt; Uhrzeiten stehen nur an
// den Programmpunkten, immer als absolute Zeitpunkte. timezone: Eingabe und Anzeige (vorerst immer
// Europe/Berlin).
//
// ownerId: SetNull nur als Sicherheitsnetz (beim Löschen eines Kontos werden Events umgehängt).
model Event {
  id          String      @id @default(cuid())
  slug        String      @unique
  title       String
  description String      @default("")
  date        DateTime
  timezone    String      @default("Europe/Berlin")
  status      EventStatus @default(DRAFT)

  // Zugang (Phase 5): accessCodeHmac ist der Zugangscode nur als HMAC, nie im Klartext (app/lib/guest/tokens.ts).
  access         GuestAccess @default(PUBLIC)
  accessCodeHmac String?

  // Prognose und Anzeige für Gäste (Abschnitt 2), Werte in Minuten.
  autoCreep         Boolean @default(true)
  creepNudgeMin     Int     @default(5)
  creepCapMin       Int     @default(30)
  guestRoundingMin  Int     @default(5)
  hysteresisMin     Int     @default(3)
  showDelayToGuests Boolean @default(false)
  guestHorizonMin   Int     @default(120)

  // Rechte der Moderator*innen (Abschnitt 7), beide standardmäßig aus. Geprüft in jeder Server Action
  // (app/lib/permissions.ts canEditPlan/canInsertLive).
  modsMayInsert   Boolean @default(false)
  modsMayEditPlan Boolean @default(false)

  // displayTokenVersion: Teil des per HMAC abgeleiteten Tafel-Links (app/lib/guest/tokens.ts) - erhöhen macht alte Links
  // ungültig. liveVersion: steigt mit JEDER Änderung an Plan oder Live-Stand (Planung ab Phase 2, Live ab
  // Phase 4) - Grundlage für den ETag des Polling-Endpunkts (Phase 3).
  displayTokenVersion Int @default(1)
  liveVersion         Int @default(0)

  // Team-Link für Dienstleister (Idee L18, app/lib/guest/tokens.ts crewToken): Team-Ansicht nur lesen, ohne Konto,
  // per HMAC abgeleitet wie der Tafel-Link. Standardmäßig aus; crewLinkVersion + 1 macht alte Links ungültig
  // (auch beim Ausschalten, damit ein alter Link beim Wiedereinschalten nicht zurückkommt).
  crewLinkEnabled Boolean @default(false)
  crewLinkVersion Int     @default(1)

  // Verknüpfung mit einem Termin in rsvp-app (Phase 7b), Aufbau wie in Seating.
  rsvpLink   Json?
  // Verknüpfung mit einem Event in Schichten ({ shiftsEventId }, app/lib/shifts/token.ts): Schichten ruft die
  // Prognose der Programmpunkte ab, damit Schichten Punkten folgen können. Beide Seiten tragen die andere id ein.
  shiftsLink Json?

  // Durchsage an Gäste und Tafel (Idee L15, app/lib/guest/announcement.ts): höchstens eine zur Zeit, aus der
  // Live-Steuerung. announcementAt kennzeichnet sie (Entfernen nennt sie, damit keine neuere verschwindet),
  // announcementUntil null = bis sie jemand entfernt. Sichtbar nur bei PUBLISHED und LIVE.
  announcementText  String?
  announcementAt    DateTime?
  announcementUntil DateTime?

  // Erinnerungen für Gäste per Push (Idee L12, app/lib/guest-alerts): OFF, nur markierte Punkte (Item.guestAlert) oder
  // alle öffentlichen Punkte. guestAlertLeadMin: so viele Minuten vor dem für Gäste angezeigten Beginn.
  // guestShiftAlertMin: zusätzlich melden, wenn sich ein Punkt um mindestens so viele Minuten verschiebt (nur live),
  // null = aus. Gäste abonnieren auf ihrem Gerät (GuestPushSubscription); ohne VAPID-Schlüssel gilt OFF.
  guestAlerts        GuestAlertMode @default(OFF)
  guestAlertLeadMin  Int            @default(10)
  guestShiftAlertMin Int?

  seriesId  String?
  series    Series?  @relation(fields: [seriesId], references: [id], onDelete: SetNull)
  ownerId   String?
  owner     User?    @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  shares                 EventAccess[]
  tracks                 Track[]
  items                  Item[]
  liveActions            LiveAction[]
  guestSessions          GuestSession[]
  places                 Place[]
  alertSettings          AlertSetting[]
  guestPushSubscriptions GuestPushSubscription[]

  @@index([ownerId])
  @@index([date])
  @@index([seriesId])
}

// Mehrere Events (Polterabend, Hochzeit, Brunch) mit gemeinsamer Übersicht unter /<slug> (Phase 3).
// Events und Reihen teilen sich einen Namensraum: Die Server Actions prüfen beim Speichern beide Tabellen
// (app/lib/planning/slug-store.ts). Zugang wird pro Event geprüft, die Reihe selbst verrät nur Titel,
// Datum und Link ihrer veröffentlichten Events. Löschen einer Reihe löst nur die Zuordnung.
model Series {
  id        String   @id @default(cuid())
  slug      String   @unique
  title     String
  ownerId   String?
  owner     User?    @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  events Event[]

  @@index([ownerId])
}

// Freigabe eines Events an ein weiteres Konto (wie in Seating). Was ein freigegebenes Konto darf,
// entscheidet eventLevel (app/lib/permissions.ts): ansehen und live steuern, aber nicht die
// Event-Einstellungen ändern, löschen oder weiter freigeben. Plan bearbeiten und Einschübe nur mit
// den Schaltern des Events (Phase 2/4, docs/KONZEPT.md Abschnitt 7).
model EventAccess {
  id        String   @id @default(cuid())
  eventId   String
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([eventId, userId])
  @@index([userId])
}

enum TrackVisibility {
  PUBLIC
  TEAM
}

// Paralleler Ablauf ("Brautpaar" neben "Gäste") mit eigener Kette. TEAM-Spuren sehen Gäste nie, auch
// nicht ihre öffentlichen Punkte. sortOrder: Reihenfolge der Tabs.
model Track {
  id         String          @id @default(cuid())
  eventId    String
  event      Event           @relation(fields: [eventId], references: [id], onDelete: Cascade)
  name       String
  sortOrder  Int
  visibility TrackVisibility @default(PUBLIC)

  items Item[]

  @@index([eventId])
}

enum ItemVisibility {
  PUBLIC
  TEAM
  SECRET
}

enum ItemStatus {
  PLANNED
  RUNNING
  DONE
  DEFERRED
  CANCELLED
}

// Ein Programmpunkt. plannedStart/plannedDurationMin/sortOrder sind der AKTUELLE Plan; original* der beim
// Live-Schalten eingefrorene Ursprungsplan (Phase 4, Abschnitt 1). Die Kette ergibt sich aus sortOrder
// innerhalb der Spur (app/lib/schedule). Live-Felder (actual*, reported*, guestShownStart) setzt erst die
// Live-Steuerung bzw. die Gästeansicht.
//
// SECRET: Titel, Ort, Beschreibung und Notiz nur für die Konten in ItemSecretViewer - auch nicht für
// Besitzer*in oder ADMIN (app/lib/planning/store.ts ersetzt sie beim Laden durch einen Platzhalter).
// version: steigt mit jeder Änderung am Punkt - Planänderungen prüfen sie und lehnen veraltete Stände ab.
model Item {
  id                 String         @id @default(cuid())
  eventId            String
  event              Event          @relation(fields: [eventId], references: [id], onDelete: Cascade)
  trackId            String
  track              Track          @relation(fields: [trackId], references: [id], onDelete: Cascade)
  sortOrder          Int
  title              String
  location           String?
  description        String?
  internalNote       String?
  visibility         ItemVisibility @default(PUBLIC)
  isAnchor           Boolean        @default(false)
  mayStartEarly      Boolean        @default(false)
  plannedStart       DateTime
  plannedDurationMin Int
  // Kürzbar (Idee L11): Mindestdauer in Minuten (kleiner als plannedDurationMin), null = nicht kürzbar. Die Prognose
  // kürzt den Punkt bei Verspätung bis hierhin, bevor sie folgende Punkte verschiebt (app/lib/schedule/project.ts).
  minDurationMin     Int?

  originalStart       DateTime?
  originalDurationMin Int?
  originalSortOrder   Int?

  status           ItemStatus @default(PLANNED)
  insertedLive     Boolean    @default(false)
  actualStart      DateTime?
  actualEnd        DateTime?
  reportedDelayMin Int?
  reportedAt       DateTime?
  cancelReason     String?
  guestShownStart  DateTime?
  // Protokollnotiz (Idee L24, Rückblick): Ergebnis bzw. Verlauf des Punkts, z. B. bei Tagesordnungspunkten
  // einer Sitzung. Nur fürs Team wie internalNote, bei SECRET nur für Eingetragene; nicht im Export.
  resultNote       String?
  // Gäste erinnern (Idee L12): wirkt bei Event.guestAlerts = MARKED und nur an öffentlichen Punkten.
  guestAlert       Boolean    @default(false)

  version   Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  waitsFor        ItemDependency[]   @relation("DependencyItem")
  waitedOnBy      ItemDependency[]   @relation("DependencyTarget")
  secretViewers   ItemSecretViewer[]
  assignees       ItemAssignee[]
  liveActions     LiveAction[]
  alertsSent      AlertSent[]
  guestAlertsSent GuestAlertSent[]

  @@index([eventId])
  @@index([trackId, sortOrder])
}

// Ort mit Adresse (Idee L22, app/lib/planning/places.ts): Ein Punkt gehört zu einem Ort, wenn sein Feld "Ort"
// (Item.location) dem Namen entspricht - ohne Groß-/Kleinschreibung, keine Fremdschlüssel. So bleiben Formulare,
// Export und Gästeansicht beim Freitext; Umbenennen zieht die Punkte mit. Gäste sehen Adresse und Routen-Link nur
// an öffentlichen Punkten (toGuestView). mapUrl: eigener Kartenlink (https), sonst eine Route zu Google Maps.
model Place {
  id        String   @id @default(cuid())
  eventId   String
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  name      String
  address   String
  mapUrl    String?
  createdAt DateTime @default(now())

  @@index([eventId])
}

// Zusammenführung: itemId beginnt frühestens nach dem Ende von waitsForItemId. Keine Zyklen - geprüft vor
// jedem Speichern und Import mit checkDependencies (app/lib/schedule/dependencies.ts).
model ItemDependency {
  itemId         String
  item           Item   @relation("DependencyItem", fields: [itemId], references: [id], onDelete: Cascade)
  waitsForItemId String
  waitsFor       Item   @relation("DependencyTarget", fields: [waitsForItemId], references: [id], onDelete: Cascade)

  @@id([itemId, waitsForItemId])
  @@index([waitsForItemId])
}

// Wer den Inhalt eines SECRET-Punkts sieht (und ihn bearbeiten bzw. live steuern darf). Verliert ein Konto
// die Freigabe fürs Event, bleibt der Eintrag wirkungslos - ohne Zugriff aufs Event sieht es nichts.
model ItemSecretViewer {
  itemId String
  item   Item   @relation(fields: [itemId], references: [id], onDelete: Cascade)
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([itemId, userId])
  @@index([userId])
}

// Zuständige eines Punkts (Idee L16): Konten mit Zugriff aufs Event, "Meine Punkte" in der Team-Ansicht. Bei
// SECRET nur Konten aus der Kontenliste. Wie ItemSecretViewer: Verliert ein Konto die Freigabe, bleibt der Eintrag
// wirkungslos (angezeigt werden nur Konten mit Zugriff). Steht in keiner Export-Datei.
model ItemAssignee {
  itemId String
  item   Item   @relation(fields: [itemId], references: [id], onDelete: Cascade)
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([itemId, userId])
  @@index([userId])
}

// Verlauf der Live-Steuerung: jede Aktion mit Konto, Zeit und Vorher/Nachher (Aufbau: app/lib/live/history.ts,
// ActionState) - Grundlage für "Rückgängig". actorId null: automatisch (Eventende) oder Konto gelöscht.
model LiveAction {
  id         String    @id @default(cuid())
  eventId    String
  event      Event     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  itemId     String?
  item       Item?     @relation(fields: [itemId], references: [id], onDelete: SetNull)
  actorId    String?
  actor      User?     @relation("LiveActionActor", fields: [actorId], references: [id], onDelete: SetNull)
  type       String
  before     Json
  after      Json
  createdAt  DateTime  @default(now())
  undoneAt   DateTime?
  undoneById String?
  undoneBy   User?     @relation("LiveActionUndoneBy", fields: [undoneById], references: [id], onDelete: SetNull)

  @@index([eventId, createdAt])
}

// Gast-Sitzung nach Zugangscode oder rsvp-Link (Phase 5/7b, app/lib/guest/session.ts). Das Cookie
// (__Host-guest-<eventId>) trägt nur den Token, hier liegt ausschließlich sein SHA-256-Hash. rsvpId: die Zusage in
// rsvp-app - eine Absage beendet ihre Sitzungen. Ändern sich Zugang oder Code, werden alle Sitzungen gelöscht.
model GuestSession {
  id        String   @id @default(cuid())
  eventId   String
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  rsvpId    String?
  createdAt DateTime @default(now())
  expiresAt DateTime

  pushSubscriptions GuestPushSubscription[]

  @@index([eventId])
  @@index([expiresAt])
}

enum AlertScope {
  MINE
  ALL
}

// Vorwarnung fürs Team (Idee L17, app/lib/alerts): Ein Konto will per Push leadMin Minuten vor dem ERWARTETEN Beginn
// (Prognose, nicht Planzeit) erinnert werden - an die eigenen Punkte (MINE, Zuständige aus Idee L16) oder an alle
// (ALL). Jedes Konto stellt das für sich ein; ohne Zugriff aufs Event bleibt der Eintrag wirkungslos.
model AlertSetting {
  eventId   String
  event     Event      @relation(fields: [eventId], references: [id], onDelete: Cascade)
  userId    String
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  scope     AlertScope @default(MINE)
  leadMin   Int        @default(10)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@id([eventId, userId])
  @@index([userId])
}

// Gesendete Vorwarnung je Punkt und Konto - damit jede nur einmal kommt. expectedStart: der angekündigte Beginn;
// rutscht der Punkt danach um mehr als leadMin, kommt eine neue (app/lib/alerts/due.ts). Gelöscht nach einer Woche
// (Cron cleanup) bzw. mit Punkt oder Konto.
model AlertSent {
  itemId        String
  item          Item     @relation(fields: [itemId], references: [id], onDelete: Cascade)
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expectedStart DateTime
  sentAt        DateTime @default(now())

  @@id([itemId, userId])
  @@index([userId])
  @@index([sentAt])
}

enum GuestAlertMode {
  OFF
  MARKED
  ALL
}

// Push-Abo eines Gäste-Geräts für die Erinnerungen eines Events (Idee L12) - ohne Namen, ohne Konto. Gilt nur, solange
// der Zugang gilt, über den es entstand: bei geschützten Events hängt es an der Gast-Sitzung (Zugangscode, rsvp-Link)
// bzw. an der Konto-Sitzung (Zugang "nur mit Konto", Vorschau des Teams) und verschwindet mit ihr (Cascade); bei
// öffentlichen Events an nichts. Wechselt der Zugang oder werden die Erinnerungen ausgeschaltet, löscht die
// Einstellung die Abos. expiresAt: Eventende + 1 Tag wie Gast-Sitzungen, danach löscht der Cron cleanup.
model GuestPushSubscription {
  id             String        @id @default(cuid())
  eventId        String
  event          Event         @relation(fields: [eventId], references: [id], onDelete: Cascade)
  endpoint       String
  p256dh         String
  auth           String
  guestSessionId String?
  guestSession   GuestSession? @relation(fields: [guestSessionId], references: [id], onDelete: Cascade)
  sessionId      String?
  session        Session?      @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  expiresAt      DateTime
  createdAt      DateTime      @default(now())

  @@unique([eventId, endpoint])
  @@index([expiresAt])
  @@index([guestSessionId])
  @@index([sessionId])
}

enum GuestAlertKind {
  START
  SHIFT
}

// Gesendete Erinnerung je Punkt und Art (Idee L12, app/lib/guest-alerts/due.ts) - für alle Gäste-Geräte zugleich, damit
// jede nur einmal kommt. start: der angekündigte Beginn (wie Gäste ihn sehen). START: "In 10 Min: …", neu, wenn der Punkt
// danach um mehr als den Vorlauf rutscht. SHIFT: "Neue Zeit: …", neu ab der nächsten Verschiebung um die Schwelle.
// Gelöscht nach einer Woche (Cron cleanup) bzw. mit dem Punkt.
model GuestAlertSent {
  itemId String
  item   Item           @relation(fields: [itemId], references: [id], onDelete: Cascade)
  kind   GuestAlertKind
  start  DateTime
  sentAt DateTime       @default(now())

  @@id([itemId, kind])
  @@index([sentAt])
}
